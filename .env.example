# Local dev: leave blank to use an embedded local Postgres (./pgdata, real
# Postgres engine via PGlite, zero setup needed).
# Production: set this to any real Postgres connection string — Vercel
# Postgres, Neon, Supabase, etc. all work. Vercel's own Postgres storage
# integration injects POSTGRES_URL into your project automatically.
POSTGRES_URL=

# Shared secret Vercel Cron sends as a Bearer token; also used to protect
# manual calls to /api/cron/collect. Set any random string.
CRON_SECRET=dev-secret

# Google AI Studio API key (Gemini). Get one free at https://aistudio.google.com/apikey
# Powers the AI article summary/implications feature and the chatbot.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite — the full flash tier only
# allows ~20 free requests/day, which is not enough for team use.
GEMINI_MODEL=

# Our own daily call budget (Gemini doesn't report remaining quota).
# Shown in the UI as "AI 잔여 N회" and enforced server-side. Default 300.
GEMINI_DAILY_BUDGET=

# Password for the admin console at /dev (collection sources + classification
# keywords are editable there, and every edit changes what the live service
# collects). Set a non-trivial value in production.
DEV_PASSWORD=
